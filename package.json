{
  "name": "sanxing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm run code-runner:build && node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web 'npm run dev -w @sanxing/api' 'npm run dev -w @sanxing/web'",
    "check": "npm run check:boundaries && tsc --noEmit && npm run check -w @sanxing/web",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "node scripts/verify.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:unit": "vitest run packages apps/web/src",
    "test:integration": "vitest run apps/api && npm run test:proxy",
    "test:proxy": "node --test apps/web/server.test.mjs",
    "test:e2e": "playwright test",
    "build": "npm run build -w @sanxing/web",
    "db:migrate": "tsx scripts/database.ts migrate",
    "data:export": "tsx scripts/database.ts export",
    "data:import": "tsx scripts/database.ts import",
    "data:delete": "tsx scripts/database.ts delete",
    "code-runner:build": "npm run code-runner:build -w @sanxing/web",
    "code-runner:packages": "node scripts/fetch-pyodide-packages.mjs",
    "benchmark:storage": "tsx scripts/benchmark-storage.ts",
    "benchmark:reads": "tsx scripts/benchmark-reads.ts",
    "evaluate:learning": "tsx scripts/evaluate-learning.ts",
    "ocr": "node scripts/serve-ocr.mjs",
    "dev:ocr": "concurrently -k -n ocr,api,web 'npm run ocr' 'npm run dev -w @sanxing/api' 'npm run dev -w @sanxing/web'"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.2",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.19",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
