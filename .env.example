# Recommended: npm run setup generates independent local secrets.
AI_MODE=mock
APP_STORAGE_MODE=local-first
# Cloud accounts and AI accounting only; learning data stays in each account's browser IndexedDB.
ALLOW_REGISTRATION=true
GATEWAY_DAILY_CALLS=200
# Per source IP, defaults to five registrations per 15 minutes.
# AUTH_REGISTRATIONS_PER_15_MIN=5
# ACCOUNT_DATA_DIR=data/cloud-accounts
APP_ORIGIN=http://127.0.0.1:3010
# Additional exact browser origins, comma-separated. Add http://<WSL_IP>:3010 for direct WSL access.
APP_ALLOWED_ORIGINS=http://localhost:3010
# Only required for the optional legacy APP_STORAGE_MODE=server deployment.
# OWNER_PASSWORD=
SESSION_SECRET=
API_HOST=127.0.0.1
API_PORT=4000
# Web uses the custom Node entry via npm run dev/start (not direct next dev/start).
# It reads SESSION_SECRET server-side to sign socket-derived client addresses.
# Optional internal API origin: literal loopback IP only, no path/credentials/query.
# API_INTERNAL_URL=http://127.0.0.1:4000
USER_TIMEZONE=Asia/Shanghai
# Legacy server learning storage only. Local-first mode never opens this learning directory.
# DATA_DIR=data/mock
# Local-first OAuth vaults are under data/ai-auth/accounts/<account-id>, encrypted with SESSION_SECRET.
# Keep that secret when restoring/migrating credentials; no personal Pi credentials are imported.
# AI_AUTH_DIR=data/ai-auth
# Optional cloud Skill catalog (JSON); downloads must use this server and catalog directory.
# SKILL_CATALOG_URL=https://your-skill-server.example/skills/catalog.json
# Optional server-side Bearer token; never sent to the browser.
# SKILL_CATALOG_TOKEN=
# Text notes only; PDF files allow 20 MB and images allow 10 MB independently.
UPLOAD_MAX_BYTES=131072
UPLOAD_MAX_COUNT=5
AI_MAX_FOLLOWUPS=3
AI_QUIZ_COUNT=3
AI_MAX_CALLS_PER_SESSION=20
AI_RUN_TIMEOUT_MS=60000
# Quiz generation has its own total budget. Stage limits are capped by the task total.
AI_QUIZ_TIMEOUT_MS=120000
AI_FIRST_RESPONSE_TIMEOUT_MS=60000
AI_STREAM_IDLE_TIMEOUT_MS=45000
# pooled reuses bounded idle model connections; fresh is for connection diagnostics.
AI_CONNECTION_POLICY=pooled
AI_MAX_OUTPUT_TOKENS=4096
# Live is opt-in: change AI_MODE above, restart, then choose a model at /ai-access.
# The API may start without a model; model tasks require an explicit saved selection.
# OAuth authorization and model selection are separate. No model is picked automatically.
# Preferences are stored in the current browser's account/mode database; mock always remains faux.
# Optional legacy server-mode fallback (not a default selection in local-first mode):
# MODEL_PROVIDER=<openai | anthropic | openai-codex | xai>
# MODEL_ID=<explicit model id from the installed Provider catalog>
# MODEL_AUTH_METHOD=oauth
# API-key alternative: set matching MODEL_PROVIDER and MODEL_AUTH_METHOD=api_key.
# MODEL_API_KEY=<server-side key; remove when env MODEL_AUTH_METHOD=oauth>
# Codex supports OAuth only. OpenAI/Codex OAuth omit an upstream output-token hard cap;
# Anthropic and xAI (Grok) OAuth keep it. Never set XAI_/OPENAI_/ANTHROPIC_ variables: live mode refuses them.
# The page saves this capability with the selected authentication; for legacy env selection ONLY:
# AI_ALLOW_UNBOUNDED_OAUTH_OUTPUT=true
# No application spending budget by default. This does NOT mean free/unlimited quota.
# To opt into an estimated budget later, set BOTH positive values; omit both to disable:
# AI_BUDGET_PER_USER_DAY=<USD>
# AI_REQUEST_RESERVATION_USD=<conservative per-request reserve in USD>
# Enable only after accepting the documented FSRS mapping/default parameters.
REVIEW_SCHEDULING_ENABLED=false

# 首次启动时仅绑定已存在的账号；有管理员后由后台管理权限
ADMIN_USERNAMES=admin

# 图片 OCR：复用 BBC_OCR 的同步接口，不保存 OCR 作业
OCR_SERVICE_URL=http://127.0.0.1:8000
OCR_SERVICE_TOKEN=
OCR_TIMEOUT_MS=120000
# 本机一并启动服务时填写现有安装位置（npm run dev:ocr）
BBC_OCR_PROJECT_PATH=../BBC_OCR
BBC_OCR_PYTHON=../BBC_OCR/.venv/bin/python
