# Recommended: npm run setup generates independent local secrets.
AI_MODE=mock
APP_ORIGIN=http://127.0.0.1:3010
# Additional exact browser origins, comma-separated. Add http://<WSL_IP>:3010 for direct WSL access.
APP_ALLOWED_ORIGINS=http://localhost:3010
OWNER_PASSWORD=
SESSION_SECRET=
API_HOST=127.0.0.1
API_PORT=4000
# Web uses the custom Node entry via npm run dev/start (not direct next dev/start).
# It reads SESSION_SECRET server-side to sign socket-derived client addresses.
# Optional internal API origin: literal loopback IP only, no path/credentials/query.
# API_INTERNAL_URL=http://127.0.0.1:4000
USER_TIMEZONE=Asia/Shanghai
# Default data directory is data/mock or data/live. Do not share it between processes.
# DATA_DIR=data/mock
# OAuth vault is separate from learning data, encrypted with SESSION_SECRET.
# Keep that secret when restoring/migrating credentials; no personal Pi credentials are imported.
# AI_AUTH_DIR=data/ai-auth
UPLOAD_MAX_BYTES=131072
UPLOAD_MAX_COUNT=5
AI_MAX_FOLLOWUPS=3
AI_QUIZ_COUNT=3
AI_MAX_CALLS_PER_SESSION=20
AI_RUN_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4096
# Live is opt-in: change AI_MODE above, restart, then choose a model at /ai-access.
# The API may start without a model; model tasks require an explicit saved selection.
# OAuth authorization and model selection are separate. No model is picked automatically.
# Preferences are stored in the current mode's learning DB; mock always remains faux.
# Optional legacy fallback (used only when no model preference is saved):
# MODEL_PROVIDER=<openai | anthropic | openai-codex | xai>
# MODEL_ID=<explicit model id from the installed Provider catalog>
# MODEL_AUTH_METHOD=oauth
# API-key alternative: set matching MODEL_PROVIDER and MODEL_AUTH_METHOD=api_key.
# MODEL_API_KEY=<server-side key; remove when env MODEL_AUTH_METHOD=oauth>
# Codex supports OAuth only. OpenAI/Codex OAuth omit an upstream output-token hard cap;
# Anthropic and xAI (Grok) OAuth keep it. Never set XAI_/OPENAI_/ANTHROPIC_ variables: live mode refuses them.
# The page requires explicit acknowledgement; for legacy env selection ONLY:
# AI_ALLOW_UNBOUNDED_OAUTH_OUTPUT=true
# No application spending budget by default. This does NOT mean free/unlimited quota.
# To opt into an estimated budget later, set BOTH positive values; omit both to disable:
# AI_BUDGET_PER_USER_DAY=<USD>
# AI_REQUEST_RESERVATION_USD=<conservative per-request reserve in USD>
# Enable only after accepting the documented FSRS mapping/default parameters.
REVIEW_SCHEDULING_ENABLED=false
