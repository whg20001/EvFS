{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["node"], "noUncheckedIndexedAccess": true
  },
  "include": ["packages/**/*.ts", "apps/api/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "pi", "apps/web"]
}
